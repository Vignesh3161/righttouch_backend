# RightTouch backend — environment template (NO secrets here; fill via
# your secret manager / deployment env). See P9 report §22 for guidance.
NODE_ENV=production
PORT=5000

# MongoDB (TLS + auth in production, e.g. mongodb+srv://...)
MONGO_URI=
# Redis is OPTIONAL (dedupe, GEO prefilter, socket adapter, revoke fan-out).
# Default OFF → in-memory/Mongo-only fallbacks, zero connections, zero logs.
# Set REDIS_ENABLED=true + REDIS_URL to enable.
REDIS_ENABLED=false
REDIS_URL=

# Auth (P6 lifetimes; generate with e.g. `openssl rand -base64 48`)
# >=32 random bytes required in production (fail-closed otherwise).
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=1h
# Optional hardening: set both to bind tokens to one environment.
JWT_ISSUER=
JWT_AUDIENCE=

# Behind Render/Nginx/ELB set true so req.ip/rate limits see the real client.
TRUST_PROXY=false
# Browser admin origins only (empty = same-origin/native-app assumption).
ALLOWED_ORIGINS=

# Dev/test helpers — MUST be false/absent in production.
ENABLE_DEV_SOCKET_ROUTES=false

# Mail / SMS / uploads / maps
SMTP_FROM=
MAILERSEND_SMTP_USER=
MAILERSEND_SMTP_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FAST2SMS_API_KEY=
GEOCODING_API_KEY=

# Location matching staleness threshold in seconds
LOCATION_STALENESS_SECONDS=300

# Razorpay (payments) + RazorpayX (payouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_X_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# KYC field encryption — KMS-backed base64 key in production (P7 refuses
# bank backfill without it); dev-only local key otherwise.
KYC_MASTER_KEY_B64=

# Firebase Cloud Messaging (prefer shared/config/firebase-credentials.json
# via GOOGLE_APPLICATION_CREDENTIALS, or these env vars)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Owner self-service signup invite (unset = Owner signup disabled)
OWNER_SIGNUP_INVITE_CODE=
