{
  "name": "righttouch_backend",
  "version": "1.0.0",
  "description": "Electorinics Appliances services and products ",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:contract": "node test/contract/run.mjs",
    "test:contract:record": "node test/contract/run.mjs --record",
    "test:socket-auth": "node --test test/contract/socket.auth.test.mjs",
    "test:repos": "node --test test/contract/repos.test.mjs",
    "test:validators": "node --test test/contract/validators.test.mjs",
    "test:p0": "node test/contract/run.mjs && node --test test/contract/socket.auth.test.mjs",
    "test:p4": "node --test test/contract/p4-profile-computation.test.mjs test/contract/p4-bank-kyc-computation.test.mjs",
    "test:p5": "node --test test/contract/p5-session.test.mjs test/contract/p5-socket-session.test.mjs",
    "test:p6": "node --test test/contract/p6-lifetime.test.mjs test/contract/p6-env-override.test.mjs",
    "test:p7": "node --test test/contract/p7-canonical.test.mjs test/contract/p7-migration.test.mjs",
    "test:p8": "node --test test/contract/p8-alias-cleanup.test.mjs",
    "test:p9": "node --test test/contract/p9-security.test.mjs",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "generate-postman": "node postman/generate_zone_wise_complete.js && node postman/generate_technician_collection.js",
    "seed:dummy": "node scripts/seed-dummy.mjs",
    "seed:fresh": "node scripts/seed-dummy.mjs --fresh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlareMindsTech/righttouch_backend.git"
  },
  "keywords": [
    "right",
    "touch"
  ],
  "author": "Flareminds",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/FlareMindsTech/righttouch_backend/issues"
  },
  "homepage": "https://github.com/FlareMindsTech/righttouch_backend#readme",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "razorpay": "^2.9.6",
    "redis": "^4.6.13",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.9.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.10"
  }
}
