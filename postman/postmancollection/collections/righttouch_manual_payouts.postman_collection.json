			"item": [
				{
					"name": "Socket.IO Handshake Probe",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Handshake reachable\", function () { pm.response.to.have.status(200); });",
									"pm.test(\"Engine.IO open packet\", function () { pm.expect(String(pm.response.text()).startsWith(\"0\")).to.eql(true); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": "{{baseUrl}}/socket.io/?EIO=4&transport=polling&t={{$timestamp}}",
						"description": "A 200 response beginning with 0 proves the Socket.IO endpoint is reachable. This does not authenticate the socket."
					},
					"response": []
				}
			]
		},
		{
			"name": "07 - Guard Cases",
			"description": "Optional negative tests. Run after the main flow; duplicate/insufficient/invalid requests are expected to fail with 4xx responses.",
			"item": [
