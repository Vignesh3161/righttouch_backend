						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"{{adminMobile}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"role\": \"{{adminRole}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/user/login",
						"description": "Admin login. Stores adminToken."
					},
					"response": []
				},
				{
					"name": "Owner - Password Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Success status\", function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"const token = body?.result?.token || body?.result?.accessToken || body?.token || body?.data?.token;",
									"pm.test(\"Token returned\", function () { pm.expect(token).to.be.a(\"string\").and.not.empty; });",
									"if (token) pm.environment.set(\"ownerToken\", token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"{{ownerMobile}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/user/login/owner",
						"description": "Owner login for revert-paid only. Stores ownerToken."
					},
					"response": []
				},
				{
					"name": "Second Admin - Password Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Success status\", function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"const token = body?.result?.token || body?.result?.accessToken || body?.token || body?.data?.token;",
									"pm.test(\"Token returned\", function () { pm.expect(token).to.be.a(\"string\").and.not.empty; });",
									"if (token) pm.environment.set(\"secondAdminToken\", token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"{{secondAdminMobile}}\",\n  \"password\": \"{{secondAdminPassword}}\",\n  \"role\": \"{{secondAdminRole}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/user/login",
						"description": "Second admin login for high-value dual-approval payouts. The approver must differ from the initiating admin."
					},
					"response": []
				}
			]
		},
		{
			"name": "01 - Payout Configuration",
			"description": "Global payout limits, dual-approval threshold, and legacy auto-payout monitoring. Automatic execution is permanently disabled.",
			"item": [
				{
					"name": "Get Admin Wallet Summary",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Not a 5xx\", function () { pm.response.code.to.be.below(500); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"url": "{{baseUrl}}/api/admin/wallet",
						"description": "Wallet summary including manual payout counts/amounts, pending approvals, and bank-run SLA."
					},
					"response": []
				},
				{
					"name": "Get Payout Settings",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Settings loaded\", function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"pm.test(\"Max withdrawal exposed\", function () { pm.expect(body?.result?.maxWithdrawalAmountPaise).to.be.a(\"number\"); });",
									"pm.test(\"Auto execution disabled\", function () { pm.expect(body?.result?.autoPayoutExecutionEnabled).to.eql(false); });",
									"pm.test(\"Deprecated auto fields listed\", function () { pm.expect(body?.result?.deprecatedAutoPayoutFields).to.be.an(\"array\"); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"url": "{{baseUrl}}/api/admin/settings/auto-payout",
						"description": "Returns the effective GlobalSetting payout config. Min/max withdrawal, cooldown, and dual-approval threshold are used by manual payouts; auto-payout execution is always false."
					},
					"response": []
				},
				{
					"name": "Update Payout Settings",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Settings updated\", function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"pm.test(\"Max persisted\", function () { pm.expect(body?.result?.maxWithdrawalAmountPaise).to.be.a(\"number\"); });",
									"pm.test(\"Manual-only remains enforced\", function () { pm.expect(body?.result?.autoPayoutExecutionEnabled).to.eql(false); });"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"minimumMaintenance\": 100,\n  \"minWithdrawalAmount\": 100,\n  \"maxWithdrawalAmount\": 50000,\n  \"withdrawalCooldownDays\": 1,\n  \"dualApprovalThreshold\": 10000\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/admin/settings/auto-payout",
						"description": "Sets the live GlobalSetting values. Rupee fields are converted to paise. maxWithdrawalAmount must be >= minWithdrawalAmount. Legacy auto fields (enabled/threshold/cron) are deprecated and omitted here."
					},
					"response": []
				},
				{
					"name": "Legacy Auto Payout Summary (deprecated)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Summary loaded\", function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"pm.test(\"Marked deprecated\", function () { pm.expect(body?.result?.deprecated).to.eql(true); });",
									"pm.test(\"Manual only\", function () { pm.expect(body?.result?.manualOnly).to.eql(true); });",
									"pm.test(\"Auto execution disabled\", function () { pm.expect(body?.result?.autoPayoutExecutionEnabled).to.eql(false); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"url": "{{baseUrl}}/api/admin/wallet/auto-payouts/summary",
						"description": "Deprecated monitoring endpoint. Counts only legacy origin=auto records; no new auto payouts can be created."
					},
					"response": []
				},
				{
					"name": "Get Technician Wallet Overview",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Overview loaded\", function () { pm.response.to.have.status(200); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"url": "{{baseUrl}}/api/admin/wallet/technician/{{technicianId}}",
						"description": "Admin-side technician wallet: available/reserved balances, payout block, payout settings, and recent withdrawals."
					},
					"response": []
				}
			]
		},
		{
			"name": "02 - Technician Withdrawal",
			"description": "Technician wallet, withdrawal request, history, and receipt. A request reserves the balance immediately; admin approval and offline transfer follow.",
			"item": [
				{
					"name": "Get My Wallet",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Wallet loaded\", function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"pm.test(\"Manual-only mode\", function () { pm.expect(body?.autoPayoutExecutionEnabled).to.eql(false); });",
									"pm.test(\"Max withdrawal exposed\", function () { pm.expect(body?.payoutLimits?.maxWithdrawalPaise).to.be.a(\"number\"); });",
									"pm.test(\"Cooldown exposed\", function () { pm.expect(body?.payoutLimits?.cooldownDays).to.be.a(\"number\"); });",
									"pm.test(\"Deprecated auto fields listed\", function () { pm.expect(body?.deprecatedAutoPayoutFields).to.be.an(\"array\"); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{technicianToken}}",
								"type": "text"
							}
						],
						"url": "{{baseUrl}}/api/technician/wallet",
						"description": "Wallet balance, KYC-backed payout destination, and payoutLimits resolved from GlobalSetting (payout.*) with env/default fallback. Auto-payout fields are deprecated and never execute."
					},
					"response": []
				},
				{
					"name": "Request Withdrawal",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Withdrawal created\", function () { pm.response.to.have.status(201); });",
									"const body = pm.response.json();",
									"if (body?.result?.withdrawalId) pm.environment.set(\"withdrawalId\", String(body.result.withdrawalId));",
									"pm.test(\"Request is pending admin review\", function () { pm.expect(body?.result?.status).to.eql(\"requested\"); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{technicianToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amountPaise\": \"{{requestAmountPaise}}\",\n  \"clientIdempotencyKey\": \"wd-{{$timestamp}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/technician/wallet/withdrawal",
						"description": "Creates a technician_request withdrawal and reserves the amount. Enforces GlobalSetting min/max, maintenance floor, verified KYC bank fingerprint, zero dues, no complaint hold, no active payout, and cooldown."
					},
					"response": []
				},
				{
					"name": "My Withdrawal History",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"History loaded\", function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"const rows = body?.result || body?.data || [];",
									"if (Array.isArray(rows) && rows[0]?._id) pm.environment.set(\"withdrawalId\", String(rows[0]._id));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{technicianToken}}",
								"type": "text"
							}
						],
						"url": "{{baseUrl}}/api/technician/wallet/withdrawalhistory",
						"description": "Lists the technician's withdrawal requests, newest first."
					},
					"response": []
				},
				{
					"name": "My Withdrawal Receipt",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Receipt endpoint reachable\", function () { pm.expect([200, 422]).to.include(pm.response.code); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{technicianToken}}",
								"type": "text"
							}
						],
						"url": "{{baseUrl}}/api/technician/wallet/withdrawal/{{withdrawalId}}/receipt",
						"description": "Returns the official receipt only after the payout is paid; before that the API returns 422."
					},
					"response": []
				}
			]
		},
		{
			"name": "03 - Admin Review & Release",
			"description": "Admin review queue, approval, offline bank transfer recording, receipt, and exports. Bank data is intentionally absent from the list; the details endpoint is audited.",
			"item": [
				{
					"name": "List Withdrawal Requests",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Queue loaded\", function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"const rows = body?.result || [];",
									"if (rows[0]?._id) pm.environment.set(\"withdrawalId\", String(rows[0]._id));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}",
								"type": "text"
							}
						],
						"url": "{{baseUrl}}/api/admin/wallet/withdrawals?status=requested&page=1&limit=25&payoutType=technician_request",
						"description": "Paginated withdrawal queue. Requested technician withdrawals need approval; approved withdrawals need the bank transfer plus mark-paid."
					},
					"response": []
				},
				{
					"name": "Get Withdrawal Details (audited bank view)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
