{
	"info": {
		"_postman_id": "c4a7e2b1-9d3f-4a6c-8e5b-7f1d2c3a4b5e",
		"name": "RightTouch - Manual Payouts (Admin & Technician)",
		"description": "Focused cross-role collection for RightTouch manual payouts.\n\nFLOW\n- Technician request reserves the balance and emits withdrawal:requested to admin_dashboard.\n- Admin reviews, approves, transfers offline, then records UTR via mark-paid.\n- Admin direct payouts below the dual-approval threshold are created approved; at/above the threshold a different admin must approve.\n- Automatic payout execution is permanently disabled (AUTO_PAYOUT_EXECUTION_ENABLED=false).\n\nSETUP\n- Set technicianMobile/adminMobile/secondAdminMobile/ownerMobile and passwords in the environment.\n- Run folder 00 first; tokens and technicianId/withdrawalId are captured automatically.\n- Use a unique UTR per payout. The default utr value is a sample only.\n\nDOCS\n- postman/postmancollection/docs/05-manual-payouts.md\n- postman/postmancollection/docs/02-socket-notifications.md",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000"
		}
	],
	"item": [
		{
			"name": "00 - Setup & Auth",
			"description": "Run these first. Technician OTP login captures technicianToken and technicianId; admin, owner, and second-admin password logins capture the tokens used by later folders.",
			"item": [
				{
					"name": "Technician - Request Login OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"OTP requested\", function () { pm.response.to.have.status(200); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"{{technicianMobile}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/technician/login/technician",
						"description": "Requests a technician login OTP. Put the SMS OTP into technicianLoginOtp."
					},
					"response": []
				},
				{
					"name": "Technician - Verify Login OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Success status\", function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"const token = body?.result?.token || body?.result?.accessToken || body?.token || body?.data?.token;",
									"pm.test(\"Token returned\", function () { pm.expect(token).to.be.a(\"string\").and.not.empty; });",
									"if (token) pm.environment.set(\"technicianToken\", token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"identifier\": \"{{technicianMobile}}\",\n  \"otp\": \"{{technicianLoginOtp}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/technician/login/technician/verify-otp",
						"description": "Verifies the OTP and stores the bearer token in technicianToken."
					},
					"response": []
				},
				{
					"name": "Technician - My Profile",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Profile loaded\", function () { pm.response.to.have.status(200); });",
									"const body = pm.response.json();",
									"const tech = body?.result?.technician || body?.result || body?.technician || body?.data || {};",
									"const id = tech?._id || tech?.technicianId || body?.result?._id;",
									"if (id) pm.environment.set(\"technicianId\", String(id));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{technicianToken}}",
								"type": "text"
							}
						],
						"url": "{{baseUrl}}/api/technician/technician/me",
						"description": "Captures technicianId for admin send-money, freeze, and wallet-overview requests."
					},
					"response": []
				},
