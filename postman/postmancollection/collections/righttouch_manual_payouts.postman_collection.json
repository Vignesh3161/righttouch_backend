								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/api/technician/wallet/withdrawal",
						"description": "Expect 400 because the amount is below the GlobalSetting minimum."
					},
					"response": []
				},
				{
