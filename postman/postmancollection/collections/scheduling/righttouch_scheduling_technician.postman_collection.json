                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Masked call initiated\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json(); const r = j.result || {};if (r.callLogId !== undefined && r.callLogId !== null) pm.collectionVariables.set(\"callLogId\", String(r.callLogId)); if (r.status !== undefined && r.status !== null) pm.collectionVariables.set(\"status\", String(r.status)); if (r.provider !== undefined && r.provider !== null) pm.collectionVariables.set(\"provider\", String(r.provider));"
                ]
              }
            }
          ],
