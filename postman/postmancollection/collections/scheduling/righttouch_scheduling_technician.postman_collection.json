{
  "info": {
    "name": "RightTouch - Scheduling (Technician)",
    "description": "Technician-side scheduling flow: offer feed, accept/decline, backup offers, grouped scheduled-job calendar, execution status, masked calls, customer no-show, and completion OTP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Setup & Auth",
      "item": [
        {
          "name": "Technician - Request Login OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"OTP requested\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/technician/login/technician",
            "description": "Sends a technician login OTP.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{technicianMobile}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Technician - Verify Login OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Technician authenticated\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "const token = (j.result && j.result.token) || j.token;",
                  "if (token) pm.collectionVariables.set('technicianToken', token);",
                  "const profileId = j.result && (j.result.technicianProfileId || j.result.technicianId);",
                  "if (profileId) pm.collectionVariables.set('technicianId', String(profileId));",
                  "pm.test('Technician token captured', function () { pm.expect(pm.collectionVariables.get('technicianToken')).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/technician/login/technician/verify-otp",
            "description": "Verifies the OTP and stores technicianToken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{technicianMobile}}\",\n  \"otp\": \"{{technicianOtp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Job Feed & Accept",
      "item": [
        {
          "name": "Technician - My Jobs (Offer Feed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Offer feed fetched\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json(); const jobs = j.result || [];",
                  "pm.test('Result is an array', function () { pm.expect(jobs).to.be.an('array'); });",
                  "if (jobs.length) { const job = jobs[0]; pm.collectionVariables.set('bookingId', String(job.bookingId || job._id || '')); pm.collectionVariables.set('broadcastVersion', String(job.version || 1)); if (job.isBackupOffer) pm.collectionVariables.set('isBackupOffer', 'true'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/technician/job-broadcast/my-jobs",
            "description": "Returns live offers, including backup offers with isBackupOffer=true. Captures bookingId and broadcast version."
          },
          "response": []
        },
        {
          "name": "Technician - Accept Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Job accepted\", function () { pm.expect([\n  200,\n  409,\n  410\n]).to.include(pm.response.code); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/technician/job-broadcast/respond/{{bookingId}}",
            "description": "Versioned accept. A backup offer is promoted to primary and the original technician is notified.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accepted\",\n  \"version\": \"{{broadcastVersion}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Technician - Decline Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Job declined\", function () { pm.expect([\n  200,\n  409,\n  410\n]).to.include(pm.response.code); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/technician/job-broadcast/respond/{{bookingId}}",
            "description": "Versioned decline. Declining the last live offer can trigger an immediate rematch.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"declined\",\n  \"version\": \"{{broadcastVersion}}\",\n  \"reason\": \"not_available\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Technician - Accepted Scheduled Jobs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Accepted scheduled jobs fetched\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json(); pm.test('Result is an array', function () { pm.expect(j.result).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/technician/jobs/accepted/scheduled",
            "description": "Accepted scheduled jobs only, including slot metadata."
          },
          "response": []
        },
        {
          "name": "Technician - Scheduled Jobs By Date & Time",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Scheduled jobs fetched\", function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json(); const r = j.result || {};",
                  "pm.test('Result is grouped by day', function () { pm.expect(r.days).to.be.an('array'); });",
                  "pm.test('Total count is present', function () { pm.expect(r.totalJobs).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/technician/jobs/scheduled?includeCompleted=false&includeCancelled=false",
            "description": "Scheduled jobs grouped by business date and time slot. Defaults to today through the last bookable day and active statuses (accepted, on_the_way, reached, in_progress). Optional query: date=YYYY-MM-DD or fromDate/toDate (max 31 days), status=accepted,on_the_way (comma separated), includeCompleted=true, includeCancelled=true, includeEmptySlots=false. Owner/Admin may pass technicianId or includeUnassigned=true."
          },
          "response": []
        },
        {
          "name": "Technician - Current Jobs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Current jobs fetched\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/technician/jobs/current",
            "description": "Active jobs for the technician."
          },
          "response": []
        },
        {
          "name": "Technician - Job History",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Job history fetched\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/technician/jobs/history",
            "description": "Technician job history, including completed scheduled jobs."
          },
          "response": []
        }
      ]
    },
